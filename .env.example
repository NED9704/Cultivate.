# Copy this file to .env and fill in the values from your Supabase dashboard.
# .env is private and is never committed.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# TMDB "API Read Access Token" (for movie and series lookup).
# themoviedb.org → your avatar → Settings → API → "API Read Access Token".
EXPO_PUBLIC_TMDB_READ_TOKEN=
